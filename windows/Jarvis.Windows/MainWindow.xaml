<Window x:Class="Jarvis.Windows.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="JARVIS — Windows" Width="1040" Height="760" MinWidth="780" MinHeight="620"
  WindowStartupLocation="CenterScreen" Background="#0B1729" Foreground="#EFF7FF">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Background="#24405D" Width="72" Height="72" CornerRadius="36" BorderBrush="#53D7EA" BorderThickness="2" Margin="0,0,16,0">
        <Viewbox Margin="12">
          <Grid Width="42" Height="42">
            <Rectangle Width="32" Height="32" Fill="#53D7EA" RadiusX="4" RadiusY="4"/>
            <Rectangle Width="7" Height="8" Fill="#082033" HorizontalAlignment="Left" Margin="9,0,0,0" VerticalAlignment="Center"/>
            <Rectangle Width="7" Height="8" Fill="#082033" HorizontalAlignment="Right" Margin="0,0,9,0" VerticalAlignment="Center"/>
            <Rectangle Width="16" Height="3" Fill="#082033" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
          </Grid>
        </Viewbox>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="JARVIS / WINDOWS" FontSize="24" FontWeight="Bold" Foreground="#53D7EA"/>
        <TextBlock Text="Локальні команди • Cloudflare AI • фінанси • макроси" Foreground="#A4B4CD" FontSize="13"/>
        <TextBlock x:Name="AIControlIndicator" Text="🟠 ШІ керує Windows · СТОП для скасування"
                   Foreground="#FFE69B" FontWeight="Bold" Visibility="Collapsed"/>
        <TextBlock x:Name="ScreenShareIndicator" Text="🔴 Екран транслюється на Pixel" Foreground="#FF786C" FontWeight="Bold" Visibility="Collapsed"/>
        <StackPanel x:Name="ControlRequestPanel" Visibility="Collapsed"
            Orientation="Horizontal" Margin="0,5,0,0">
          <TextBlock Text="📱 Pixel запитує керування Windows" Foreground="#FFE69B"
            VerticalAlignment="Center" FontWeight="Bold"/>
          <Button Content="Дозволити" Click="AllowControl_Click"
            Background="#236F55" Foreground="White" Margin="8,0,4,0"/>
          <Button Content="Відхилити" Click="DenyControl_Click"
            Margin="4,0,0,0"/>
        </StackPanel>
        <StackPanel x:Name="ControlActivePanel" Visibility="Collapsed"
            Orientation="Horizontal" Margin="0,5,0,0">
          <TextBlock Text="🔴 Pixel керує мишею і клавіатурою"
            Foreground="#FF786C" FontWeight="Bold" VerticalAlignment="Center"/>
          <Button Content="■ Заборонити керування" Click="StopControl_Click"
            Background="#D34C4C" Foreground="White" Margin="8,0,0,0"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="StopScreenShareButton" Content="■ Зупинити екран" Click="StopScreenShare_Click" Visibility="Collapsed" Background="#D34C4C" Foreground="White"/>
        <Button x:Name="OrbToggleButton" Content="◎ Плаваючий" Click="OrbToggle_Click" ToolTip="Показати або приховати плаваючого JARVIS"/>
        <Button x:Name="MicButton" Click="MicButton_Click" Content="🎙 Слухати"/>
        <Button Click="StopButton_Click" Content="■ Стоп"/>
      </StackPanel>
    </Grid>
    <TabControl Grid.Row="1" x:Name="Tabs">
      <TabItem Header="Асистент">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBox x:Name="ChatHistory" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AcceptsReturn="True" FontSize="15" Margin="0,0,0,12"/>
          <TextBox x:Name="CommandInput" Grid.Row="1" Height="75" AcceptsReturn="True" TextWrapping="Wrap" KeyDown="CommandInput_KeyDown" ToolTip="Enter — виконати, Shift+Enter — новий рядок"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <ComboBox x:Name="AiMode" SelectedIndex="0" Width="135">
              <ComboBoxItem Content="chat"/><ComboBoxItem Content="web"/><ComboBoxItem Content="analysis"/><ComboBoxItem Content="image"/>
            </ComboBox>
            <Button Click="AnalyzeScreenButton_Click" Content="👁 Аналіз екрана" ToolTip="Разовий знімок лише після згоди на ПК"/>
            <Button Click="RunButton_Click" Content="Виконати ↵"/>
            <Button Click="ClearConversationButton_Click" Content="Новий діалог"/>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Пристрої">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
          <TextBlock Text="Обери пристрій для наступних голосових команд" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
          <TextBlock Text="Команди «телефон», «годинник», «комп'ютер» змінюють ціль, а JARVIS Finance завжди використовує базу Pixel. Комп'ютер може приймати лише дозволені локальні дії." Foreground="#A4B4CD" TextWrapping="Wrap" Width="680" HorizontalAlignment="Left" Margin="0,0,0,10"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="📱 Телефон" Click="TargetPhone_Click"/>
            <Button Content="⌚ Годинник" Click="TargetWatch_Click"/>
            <Button Content="🖥 Комп'ютер" Click="TargetComputer_Click"/>
          </StackPanel>
          <TextBlock x:Name="CurrentDeviceLabel" Text="🖥 Комп'ютер" FontSize="19" Foreground="#53D7EA" FontWeight="Bold"/>
          <Button Content="Перевірити підключення" Click="CheckDevices_Click" Width="230" HorizontalAlignment="Left" Margin="0,14,0,14"/>
          <TextBox x:Name="DeviceStatusReport" IsReadOnly="True" TextWrapping="Wrap" Height="180" Width="680" HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="На годиннику команди передає Pixel. Для цього потрібні оновлений Android-код, розгорнутий Cloudflare Relay та дозвіл приймати команди." Foreground="#A4B4CD" TextWrapping="Wrap" Margin="0,12,0,0" Width="680" HorizontalAlignment="Left"/>
          <Separator Margin="0,12"/>
          <TextBlock Text="🔒 Захищене спарювання Pixel з Windows — P-256"
                     FontWeight="Bold" FontSize="16" Foreground="#53D7EA"/>
          <TextBlock Text="1. Створи одноразовий код на ПК. 2. Введи ID і код на Pixel. 3. Перевір відбиток ключа телефона. 4. Підтвердь на ПК. Паролі і ключі не передаються."
                     TextWrapping="Wrap" Width="680" Margin="0,8"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="1 · Створити код" Click="PairBegin_Click"/>
            <Button Content="3 · Перевірити запит" Click="PairPending_Click"/>
            <Button Content="4 · Підтвердити Pixel" Click="PairApprove_Click"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="Перелік спарених" Click="PairList_Click"/>
            <Button Content="Відкликати Pixel" Click="PairRevoke_Click"/>
          </StackPanel>
          <TextBlock Text="Дозволи для спареного Pixel / команд із Watch7"
                     FontWeight="Bold" FontSize="14" Margin="0,12,0,4"/>
          <CheckBox x:Name="GrantReadOnly" IsChecked="True"
                    Content="Стан і перелік пристроїв" Margin="0,3"/>
          <CheckBox x:Name="GrantMedia"
                    Content="Медіа й гучність Windows" Margin="0,3"/>
          <CheckBox x:Name="GrantApps"
                    Content="Запуск перевірених програм (браузер, Блокнот, калькулятор)" Margin="0,3"/>
          <CheckBox x:Name="GrantLocks"
                    Content="Блокування Windows / вимкнення монітора (ще й локальна згода)" Margin="0,3"/>
          <CheckBox x:Name="GrantWatch"
                    Content="Делегувати команди Galaxy Watch7 через спарений Pixel" Margin="0,3"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="Прочитати дозволи" Click="PairGrantsLoad_Click"/>
            <Button Content="Зберегти дозволи" Click="PairGrantsSave_Click"/>
          </StackPanel>
          <TextBox x:Name="PairingCodeReport" Width="680" Height="115" IsReadOnly="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8"/>
          <TextBlock Foreground="#FFCC99" TextWrapping="Wrap" Width="680"
                     Text="До переходу всіх клієнтів на підписаний Relay v2 старий спільний ключ v1 залишається обмеженим, але не захищений pairing."/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="JARVIS Finance">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Єдина база JARVIS Finance — на Pixel. Підключення потрібне для записів і звітів з Windows. Локальні старі записи лише для перегляду." Foreground="#A4B4CD" Margin="0,0,0,12"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBox x:Name="FinanceInput" Width="540" ToolTip="витратив 150 готівка транспорт таксі"/>
            <Button Click="AddFinanceButton_Click" Content="Записати"/>
            <Button Click="RefreshFinanceButton_Click" Content="Оновити звіт"/>
          </StackPanel>
          <TextBox Grid.Row="2" x:Name="FinanceReport" Margin="0,10,0,0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
        </Grid>
      </TabItem>
      <TabItem Header="Макроси">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Точна голосова фраза → локальні дії (по одній команді на рядок; макрос не виконує shell-код)" Foreground="#A4B4CD" TextWrapping="Wrap"/>
          <TextBox x:Name="MacroTrigger" Grid.Row="1" Margin="0,10,0,0" Height="36" ToolTip="Наприклад: робочий режим"/>
          <TextBox x:Name="MacroActions" Grid.Row="2" Margin="0,8,0,0" Height="108" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" ToolTip="відкрий блокнот&#10;гучність 40&#10;скажи починаю роботу"/>
          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Click="SaveMacroButton_Click" Content="Зберегти макрос"/>
              <Button Click="RunMacroButton_Click" Content="Перевірити"/>
            </StackPanel>
            <ListBox x:Name="MacroList" Background="#1D304A" Foreground="#EAF8FF" Margin="4" Height="100"/>
            <Separator Margin="0,12"/>
            <TextBlock Text="Розумні макроси v2: тригер, умови, дії, розклад" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Безпечні шаблони (лише заповнять поля, не запускаються)" TextWrapping="Wrap" Margin="0,5,0,3"/>
            <ComboBox x:Name="MacroV2TemplateList" DisplayMemberPath="Name" Height="32" Margin="0,4"/>
            <Button Content="Заповнити редактор із шаблону" Click="FillMacroV2Template_Click" Margin="0,4,0,10"/>
            <TextBox x:Name="MacroV2Name" Margin="0,6" ToolTip="Назва: Робочий режим"/>
            <TextBox x:Name="MacroV2Trigger" Margin="0,6" ToolTip="Голосовий тригер: робота"/>
            <TextBox x:Name="MacroV2Schedule" Margin="0,6" ToolTip="Розклад HH:mm або порожньо"/>
            <TextBlock Text="Тригер за подією: network.online, network.offline або app.active:notepad (необов'язково)" TextWrapping="Wrap"/>
            <TextBox x:Name="MacroV2Event" Margin="0,6" ToolTip="network.online / network.offline / app.active:notepad / app.start:notepad / device.attach:vid_046d&pid_c52b"/>
            <TextBlock Text="Мінімальна пауза між запусками (секунди, 0–86400)"/>
            <TextBox x:Name="MacroV2Cooldown" Text="60" Margin="0,6"/>
            <TextBlock Text="Умови: день=пн,вт; час=09:00-18:00; інтернет=так; процес=notepad"/>
            <TextBox x:Name="MacroV2Conditions" Height="70" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Margin="0,6"/>
            <TextBlock Text="Дії: якщо умова / інакше / кінець; повтори 1..5 / кінець"/>
            <TextBox x:Name="MacroV2Steps" Height="120" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Margin="0,6"/>
            <StackPanel Orientation="Horizontal">
              <Button Click="SaveMacroV2Button_Click" Content="Зберегти v2"/>
              <Button Click="RunMacroV2Button_Click" Content="Перевірити v2"/>
            </StackPanel>
            <ListBox x:Name="MacroV2List" Height="105" Background="#1D304A" Foreground="#EAF8FF"/>
          </StackPanel></ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Система ПК">
        <StackPanel Margin="18" Width="670" HorizontalAlignment="Left">
          <TextBlock Text="🖥 Моніторинг Windows" FontSize="19" FontWeight="Bold" Margin="0,0,0,9"/>
          <TextBlock Text="Показники знімаються лише за запитом, без фонової телеметрії. Команда: «стан комп'ютера» або «статус пк». Також доступна з Pixel і Watch7 у режимі «комп'ютер»." Foreground="#A4B4CD" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Button Content="↻ Оновити показники" Click="RefreshSystemStatus_Click" Width="225" HorizontalAlignment="Left"/>
          <TextBox x:Name="SystemStatusReport" Height="110" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap"/>
          <TextBlock Text="Температури CPU/GPU не відображаються: Windows не має універсального надійного API для них. Пізніше можна додати окремий датчик через LibreHardwareMonitor." TextWrapping="Wrap" Foreground="#A4B4CD" Margin="0,12,0,0"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Обмін файлами">
        <StackPanel Margin="20" Width="660" HorizontalAlignment="Left">
          <TextBlock Text="📂 Обмін файлами Windows ↔ Pixel" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
          <TextBlock Text="Вибери один файл до 1 МіБ. Він зберігатиметься тільки в оперативній пам'яті приватного Cloudflare Relay максимум 2 хвилини. На Pixel відкрий перегляд Windows → «📂 Файли ПК» → «Зберегти». Не передавай паролі чи секрети: це HTTPS, але ще не наскрізне шифрування." TextWrapping="Wrap" Foreground="#A4B4CD" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="📤 Передати на Pixel" Click="SendFileToPixel_Click" Width="225"/>
            <Button Content="📥 Отримати з Pixel" Click="ReceiveFileFromPixel_Click" Width="225"/>
          </StackPanel>
          <TextBox x:Name="FileExchangeStatus" Margin="0,12,0,0" Height="120" IsReadOnly="True" TextWrapping="Wrap"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Нотатки">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="110"/>
          </Grid.RowDefinitions>
          <TextBlock Text="📱 Єдині нотатки JARVIS — на Pixel. Додавай і переглядай через авторизований Cloudflare Relay." Foreground="#A4B4CD" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBox x:Name="PhoneNoteInput" Width="430" Height="40"
              ToolTip="Напиши текст нотатки (до 180 символів)"/>
            <Button Click="AddPhoneNote_Click" Content="Записати на Pixel"/>
            <Button Click="LoadPhoneNotes_Click" Content="Показати нотатки"/>
          </StackPanel>
          <TextBox Grid.Row="2" x:Name="PhoneNotesReport" Margin="0,12,0,14"
            TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Grid.Row="3" Text="Архів ранніх локальних нотаток Windows (лише читання, не синхронізовано; нічого не видаляємо)" Foreground="#A4B4CD" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <TextBox Grid.Row="4" x:Name="NotesText" TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
        </Grid>
      </TabItem>
      <TabItem Header="Налаштування">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14" Width="680" HorizontalAlignment="Left">
            <TextBlock Text="Cloudflare JARVIS AI Worker — той самий сервер, що й на телефоні" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="HTTPS /chat (не вводь тут OpenAI API-ключ)" Foreground="#A4B4CD"/>
            <TextBox x:Name="WorkerUrl" Margin="0,5,0,12"/>
            <TextBlock Text="Особистий токен Worker (захищається Windows DPAPI)" Foreground="#A4B4CD"/>
            <PasswordBox x:Name="WorkerToken" Background="#1D304A" Foreground="White" Padding="10" Margin="0,5,0,12"/>
            <CheckBox x:Name="EnableSignedRelay" Content="Використовувати підписані команди v2 з Pixel/Watch7 після спарювання (потрібне налаштування на Pixel)" Margin="0,8"/>
            <CheckBox x:Name="EnableDeviceRelay" Content="Дозволити з'єднання з Pixel і Watch7 через приватний Cloudflare Relay" Margin="0,8" ToolTip="Команди передаються через твій Cloudflare Worker. Увімкни тільки для власного акаунта."/>
            <CheckBox x:Name="EnableScreenShare" Content="🖥 Дозволити Pixel переглядати мій екран (тільки за активного запиту)" Margin="0,8" ToolTip="Містить усі видимі вікна, включно з особистими даними; передається HTTPS через твій Cloudflare Worker."/>
            <TextBlock Text="🔒 Кадри не зберігаються. Для початку потрібна кнопка на Pixel; індикатор трансляції видно у Windows. Працює лише поки JARVIS відкритий." Foreground="#A4B4CD" TextWrapping="Wrap" Margin="8,0,0,8"/>
            <CheckBox x:Name="EnableRemoteControl"
                Content="🖱 Дозволяти запити Pixel на мишу та клавіатуру (кожен сеанс підтверджую окремо)"
                Margin="0,8" ToolTip="Дозвіл лише на власному Windows; кожне нове підключення потрібно явно схвалити на комп'ютері."/>
            <TextBlock Text="Керування не починається без натискання «Дозволити» на ПК. Видимі всі дії. Прихованого доступу або роботи на екрані входу немає."
                Foreground="#A4B4CD" TextWrapping="Wrap" Margin="8,0,0,8"/>
            <CheckBox x:Name="LaunchAtSignIn" Content="Запускати JARVIS після входу у Windows (без адміністратора)" Margin="0,8"/>
            <CheckBox x:Name="MinimizeToTray" Content="Згортати в трей при закритті вікна" Margin="0,8"/>
            <CheckBox x:Name="EnableAiDesktop" Content="Дозволяти локальний AI Desktop Agent після підтвердження" Margin="0,8"/>
            <CheckBox x:Name="UseAiDesktopVision" Content="AI Desktop: передавати JPEG екрана в ШІ під час сесії (за замовчуванням OFF)" Margin="0,8"/>
            <CheckBox x:Name="EnableWakeWord" Content="Офлайн-пробудження «Джарвіс» (потребує Windows-розпізнавача)" Margin="0,8"/>
            <TextBlock Text="За відсутності мовного пакета режим не запускається; whisper.cpp буде додано окремо."
                Foreground="#A4B4CD" TextWrapping="Wrap" Margin="8,0,0,6"/>
            <CheckBox x:Name="ShowFloatingOrb" Content="Показувати плаваючого JARVIS" IsChecked="True" Margin="0,8"/>
            <CheckBox x:Name="SpeakReplies" Content="Озвучувати відповіді" IsChecked="True" Margin="0,6"/>
            <CheckBox x:Name="StayOnTop" Content="Поверх інших вікон" Margin="0,6" Checked="StayOnTop_Changed" Unchecked="StayOnTop_Changed"/>
            <TextBlock Text="Голос Windows (список залежить від встановлених голосів)" Margin="0,14,0,5"/>
            <ComboBox x:Name="VoiceChoices" Width="340" HorizontalAlignment="Left"/>
            <TextBlock Text="Мова розпізнавання (потрібен мовний пакет Windows)" Margin="0,14,0,5"/>
            <ComboBox x:Name="RecognizerChoices" Width="340" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <Button Click="SaveSettingsButton_Click" Content="Зберегти налаштування"/>
              <Button Click="TestAiButton_Click" Content="Перевірити ШІ"/>
              <Button Click="TestSpeechButton_Click" Content="Тест голосу"/>
            </StackPanel>
            <TextBlock Text="Глобальна комбінація Ctrl+Shift+J активує слухання. Немає прихованого безперервного прослуховування." Foreground="#A4B4CD" TextWrapping="Wrap" Margin="0,14,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#152237" Padding="12" Margin="0,10,0,0" CornerRadius="7">
      <TextBlock x:Name="StatusText" Text="Готовий. Ctrl+Shift+J — мікрофон; Enter — виконати текст." Foreground="#53D7EA"/>
    </Border>
  </Grid>
</Window>
