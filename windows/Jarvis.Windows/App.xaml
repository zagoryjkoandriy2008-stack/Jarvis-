<Application x:Class="Jarvis.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#152237"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#53D7EA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A4B4CD"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#061322"/>
      <Setter Property="Background" Value="#53D7EA"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#EFF7FF"/>
      <Setter Property="Background" Value="#1D304A"/>
      <Setter Property="CaretBrush" Value="#53D7EA"/>
      <Setter Property="BorderBrush" Value="#49617E"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="9"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="#0B1729"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Background" Value="#182D46"/>
      <Setter Property="Foreground" Value="#E7F7FF"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="2"/>
    </Style>
  </Application.Resources>
</Application>
