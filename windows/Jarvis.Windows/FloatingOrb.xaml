<Window x:Class="Jarvis.Windows.FloatingOrb"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="JARVIS" Width="168" Height="196"
  Background="Transparent" AllowsTransparency="True" WindowStyle="None"
  ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
  Topmost="True" WindowStartupLocation="Manual">
  <Grid>
    <!-- PixelFace is shared with the full Windows hero; the button captures clicks. -->
    <Border x:Name="OrbRing" Background="Transparent" BorderBrush="#50DFFB"
      BorderThickness="0" Width="117" Height="117" CornerRadius="59"
      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
      MouseLeftButtonDown="Orb_Drag" MouseLeftButtonUp="Orb_DragEnd"/>
    <Button x:Name="OrbButton" Click="OrbButton_Click"
      Width="115" Height="115" Padding="0" BorderThickness="0" Margin="0,4,0,0"
      Background="Transparent" Cursor="Hand" HorizontalAlignment="Center"
      VerticalAlignment="Top" ToolTip="Джарвіс: натисни для слухання">
      <local:PixelFace x:Name="FloatingFace" Width="115" Height="115"/>
    </Button>
    <TextBlock x:Name="ScreenCastBadge" Text="● ЕКРАН" Visibility="Collapsed"
      Background="#D73542" Foreground="White" FontWeight="Bold" FontSize="11"
      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"
      Padding="8,2" ToolTip="Екран зараз видно на Pixel"/>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
      <TextBlock x:Name="TargetLabel" Foreground="#53D7EA" HorizontalAlignment="Center"
        Text="🖥 Комп'ютер" Margin="0,0,0,4" FontSize="12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="PhoneButton" Content="📱" Click="Phone_Click" Width="42" Height="32"
          FontSize="14" Padding="0" ToolTip="Режим телефон"/>
        <Button x:Name="WatchButton" Content="⌚" Click="Watch_Click" Width="42" Height="32"
          FontSize="14" Padding="0" ToolTip="Режим годинник"/>
        <Button x:Name="PcButton" Content="🖥" Click="Pc_Click" Width="42" Height="32"
          FontSize="14" Padding="0" ToolTip="Режим комп'ютер"/>
      </StackPanel>
    </StackPanel>
    <Grid.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Відкрити JARVIS" Click="ShowMain_Click"/>
        <MenuItem Header="Почати слухати" Click="OrbButton_Click"/>
        <MenuItem Header="Приховати плаваюче вікно" Click="HideOrb_Click"/>
        <MenuItem Header="■ Зупинити перегляд екрана" Click="StopScreen_Click"/>
      </ContextMenu>
    </Grid.ContextMenu>
  </Grid>
</Window>
