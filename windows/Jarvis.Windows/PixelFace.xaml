<UserControl x:Class="Jarvis.Windows.PixelFace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False" IsHitTestVisible="False"
    Loaded="PixelFace_Loaded" Unloaded="PixelFace_Unloaded">
  <!-- Matches Pixel's 16x16 face, nested rings and Android palette. -->
  <Viewbox Stretch="Uniform" SnapsToDevicePixels="True">
    <Canvas Width="210" Height="210">
      <Ellipse x:Name="OuterRing" Canvas.Left="10.5" Canvas.Top="10.5"
               Width="189" Height="189" Stroke="#4CC5EC" StrokeThickness="1"
               Opacity="0.6"/>
      <Ellipse x:Name="MiddleRing" Canvas.Left="24.5" Canvas.Top="24.5"
               Width="161" Height="161" Stroke="#2478A7" StrokeThickness="1"
               Opacity="0.6"/>
      <Ellipse x:Name="FaceRing" Canvas.Left="31.3" Canvas.Top="31.3"
               Width="147.4" Height="147.4" Fill="#0D2E54" Stroke="#72EBFF"
               StrokeThickness="3"/>
      <Canvas x:Name="EyesNormal">
        <Rectangle Canvas.Left="77.0" Canvas.Top="88.3" Width="16.8" Height="16.8" Fill="#D9FEFF"/>
        <Rectangle Canvas.Left="116.2" Canvas.Top="88.3" Width="16.8" Height="16.8" Fill="#D9FEFF"/>
      </Canvas>
      <Canvas x:Name="EyesBlink" Visibility="Collapsed">
        <Rectangle Canvas.Left="77.0" Canvas.Top="94.0" Width="16.8" Height="5.6" Fill="#D9FEFF"/>
        <Rectangle Canvas.Left="116.2" Canvas.Top="94.0" Width="16.8" Height="5.6" Fill="#D9FEFF"/>
      </Canvas>
      <Canvas x:Name="IdleMouth">
        <Rectangle Canvas.Left="82.6" Canvas.Top="121.8" Width="11.2" Height="5.6" Fill="#D9FEFF"/>
        <Rectangle Canvas.Left="93.8" Canvas.Top="127.4" Width="22.4" Height="5.6" Fill="#D9FEFF"/>
        <Rectangle Canvas.Left="116.2" Canvas.Top="121.8" Width="11.2" Height="5.6" Fill="#D9FEFF"/>
      </Canvas>
      <Canvas x:Name="ListeningMouth" Visibility="Collapsed">
        <Rectangle Canvas.Left="88.2" Canvas.Top="121.8" Width="33.6" Height="5.6" Fill="#D9FEFF"/>
      </Canvas>
      <Canvas x:Name="ThinkingMouth" Visibility="Collapsed">
        <Rectangle Canvas.Left="88.2" Canvas.Top="121.8" Width="5.6" Height="5.6" Fill="#D9FEFF"/>
        <Rectangle Canvas.Left="99.4" Canvas.Top="121.8" Width="5.6" Height="5.6" Fill="#D9FEFF"/>
        <Rectangle Canvas.Left="110.6" Canvas.Top="121.8" Width="5.6" Height="5.6" Fill="#D9FEFF"/>
      </Canvas>
      <Rectangle x:Name="SpeakingMouth" Canvas.Left="93.8" Canvas.Top="116.2"
                 Width="22.4" Height="11.2" Fill="#D9FEFF" Visibility="Collapsed"/>
    </Canvas>
  </Viewbox>
</UserControl>
